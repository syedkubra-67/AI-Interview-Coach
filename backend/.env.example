# Server Port Configuration
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection URI (Atlas or Local)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-interview-coach
MONGO_URI=mongodb://127.0.0.1:27017/ai-interview-coach

# JWT Authentication Config
JWT_SECRET=replace_with_your_super_secret_session_token_key_here
JWT_EXPIRE=30d

# Google Gemini API Key
# Get a key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_goes_here
